  "normalizer": "NFC -> replace(/\\s+/ -> ' ') -> lowercase",
  "pre_tokenizer_regex": "<\\|startoftext\\|>|<\\|endoftext\\|>|'s|'t|'re|'ve|'m|'ll|'d|[\\p{L}]+|[\\p{N}]|[^\\s\\p{L}\\p{N}]+",
  "bpe": {
