# Chrome profiles: Core ML needs a real on-disk, non-incognito one.
.chrome-profile*/
node_modules/
bench/
.DS_Store

# Constants blobs are the published artifact; they never live in git.
weights/
*.bin
# ...except the small reference tensors a verification set needs.
!families/*/entries/*/verification/*.f16.bin

# A probe writes this for the machine it ran on; the entry it produced
# carries a copy, so the loose file is scratch.
/target.json
