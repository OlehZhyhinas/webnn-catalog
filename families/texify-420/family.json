  "tokenizer": {
    "algorithm": "HuggingFace tokenizers (Donut/mBART byte-level BPE), vocab 50000",
    "files": [
      "tokenizer/tokenizer.json",
      "tokenizer/tokenizer_config.json",
      "tokenizer/special_tokens_map.json"
    ],
    "module": null,
    "class": null,
    "maxLength": 384,
    "produces": "decode.token (consumed as the next step's input; the family does not run the tokenizer in-graph)",
    "parity": "export_texify.py greedy ids vs transformers AutoTokenizer on vikp/texify"
  },
  "constants": {
    "scope": "per-entry",
    "note": "Encoder ~174 MiB, decode-step ~423 MiB (lm_head is ~100 MiB). Build times are tens of seconds."
  },
  "verification": {
    "images": 18,
    "source": "LatexGen/public/bench-images/",
    "tokens": "identical to fp32 Hugging Face generate() on the same preprocessed bytes, 18/18",
    "preprocess": "Donut 4.36 thumbnail+pad, not in-graph"
  },
  "notes": "Issue path models/texify-420 maps onto families/texify-420 in this catalog. Preprocessing (thumbnail and pad) stays in the consumer."
