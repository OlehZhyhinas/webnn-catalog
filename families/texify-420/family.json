{
  "id": "texify-420",
  "name": "Texify, 420×420, Donut-Swin + mBART",
  "summary": "LatexGen's second-pass equation OCR (vikp/texify, ~300M): a Donut-Swin encoder on 420×420 RGB and an 8-layer mBART greedy decode-step, cache 384. float16 throughout. A preprocessed image goes in; greedy token ids come out.",
  "task": "image-to-latex",
  "source": {
    "model": "vikp/texify",
    "revision": null,
    "precision": "float16 throughout; LayerNorm is the native WebNN op because a naive fp16 sum-of-squares overflows at Donut-Swin stage 2",
    "resolution": 420,
    "steps": null
  },
