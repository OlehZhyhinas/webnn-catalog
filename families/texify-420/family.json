    "chaining": {
      "contexts": "ONE MLContext for both graphs. navigator.ml.createContext({deviceType: 'gpu'}).",
      "pattern": [
        "1. dispatch(encoder, {pixel_values}, {dec0_k..dec7_v}). Bind those 16 tensors as the decode graph's matching inputs.",
        "2. Zero the 16 self-attention cache tensors once per image (writable).",
        "3. For step = 0..383: write token and step; dispatch(decode, {token, step, encoder K/V, cacheIn}, {token, cacheOut}); read token; swap cacheIn/cacheOut; stop on EOS 2.",
        "4. If step hits 383 without EOS, the last token is forced EOS 2 (HuggingFace forced_eos_token_id).",
        "5. Do not emit logits on the timed graph."
      ],
      "everyOutputMustBeBound": "WebNN requires every declared output bound at dispatch. Allocate caches as non-readable except token."
    }
